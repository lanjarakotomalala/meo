{
  "version": "0.16.1",
  "type": "wordpress-theme",
  "keywords": [
    "wordpress",
    "theme",
    "starter theme",
    "wpemerge"
  ],
  "license": "GPL-2.0-only",
  "require": {
    "php": ">=5.5",
    "composer/installers": "^1.0",
    "htmlburger/wpemerge": "~0.16.0",
    "htmlburger/wpemerge-app-core": "~0.16.0"
  },
  "require-dev": {
    "filp/whoops": "^2.2",
    "htmlburger/wpemerge-cli": "~0.16.0",
    "symfony/debug": "~3.0",
    "wp-coding-standards/wpcs": "^2.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^v0.7.1.0"
  },
  "autoload": {
    "psr-4": {
      "MyApp\\": "app/src/"
    }
  },
  "scripts": {
    "install-test-env": [
      "wpemerge config:create"
    ],
    "install-dev-env": [
      "@php wpemerge config:create",
      "@php wpemerge install:dependencies",
      "@php wpemerge assets:build"
    ],
    "post-create-project-cmd": "@install-dev-env"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "audit": {
      "ignore": [
        "PKSA-jj5t-2zs1-dcfm",
        "PKSA-gm5x-j3mz-71n9",
        "PKSA-hn62-zkx4-1y5q",
        "PKSA-gvzg-s447-b5b5"
      ]
    }
  }
}
